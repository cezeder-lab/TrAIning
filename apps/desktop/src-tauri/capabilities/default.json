{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions de la fen\u00eatre principale",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-ask",
    "dialog:allow-message",
    "opener:allow-open-url",
    "clipboard-manager:allow-write-image",
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "https://raw.githubusercontent.com/yuhonas/free-exercise-db/*"
        },
        {
          "url": "https://world.openfoodfacts.org/*"
        },
        {
          "url": "https://*.openfoodfacts.org/*"
        },
        {
          "url": "https://ciqual.anses.fr/*"
        },
        {
          "url": "https://www.data.gouv.fr/*"
        },
        {
          "url": "https://static.data.gouv.fr/*"
        }
      ]
    }
  ]
}